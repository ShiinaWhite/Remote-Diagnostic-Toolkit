    <OutputType>Exe</OutputType>
    <AssemblyName>rdt</AssemblyName>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Rdt.Core/Rdt.Core.csproj" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="Rdt.Tests" /></ItemGroup>
